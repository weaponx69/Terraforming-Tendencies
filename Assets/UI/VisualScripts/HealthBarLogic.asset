using UnityEngine;
using UnityEngine.Playables;

[CreateAssetMenu(fileName = "HealthBarLogic", menuName = "Visual Scripting/Health Bar Logic")]
public class HealthBarLogic : PlayableAsset, ITimelineAsset
{
    public ExposedReference<GameObject> healthBarObject;
    public ExposedReference<float> maxHealth = 100f;
    public ExposedReference<float> currentHealth = 50f;
    
    public override Playable CreatePlayable(PlayableGraph graph)
    {
        var playable = ScriptPlayable<HealthBarLogicBehaviour>.Create(graph);
        var behaviour = playable.GetBehaviour();
        behaviour.healthBarObject = healthBarObject.Resolve(graph.GetResolver());
        behaviour.maxHealth = maxHealth.GetValue(graph.GetResolver());
        behaviour.currentHealth = currentHealth.GetValue(graph.GetResolver());
        return playable;
    }
}

public class HealthBarLogicBehaviour : PlayableBehaviour
{
    public GameObject healthBarObject;
    public float maxHealth = 100f;
    public float currentHealth = 50f;
    
    public override void OnBehaviourPlay(Playable playable, FrameData info)
    {
        if (healthBarObject != null)
        {
            float healthPercentage = currentHealth / maxHealth;
            var progressBar = healthBarObject.GetComponent<UnityEngine.UI.Image>();
            if (progressBar != null)
            {
                progressBar.fillAmount = healthPercentage;
            }
        }
    }
}